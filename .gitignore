# Build artefacts. __pycache__ matters for more than tidiness: a .pyc embeds the
# absolute path it was compiled from, so committing or shipping one discloses
# the build account's username and directory layout.
__pycache__/
*.py[cod]

# The built package. Large, and regenerated by tools/build_yxi.py.
dist/

# Scratch output from tools/check_panels.py --harness.
build/
